---
import { hero, site } from '../data/site';
---
<section class="site-shell hero" id="top">
  <div class="hero__copy">
    <p class="site-kicker">{hero.kicker}</p>
    <h1>{hero.title}<em>{hero.titleEm}</em>{hero.titleEnd}</h1>
    <p class="hero__lead">{hero.lead}</p>
    <div class="hero__actions">
      <a class="site-button" href="#works">看看我做过的东西</a>
      <a class="site-button--quiet" href={site.github} target="_blank" rel="noopener">GitHub</a>
    </div>
    <p class="hero__note">{hero.note}</p>
  </div>
  <div class="hero__visual" aria-hidden="true">
    <p class="hero__vertical">把想法做成能用的东西</p>
    <span class="hero__seal han-stamp han-stamp--lg">{site.seal}</span>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
    padding: clamp(56px, 8vw, 96px) 0 clamp(64px, 9vw, 112px);
  }
  h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.18;
    letter-spacing: .04em;
    text-wrap: balance;
  }
  h1 em { color: var(--han-color-accent-text); font-style: normal; }
  .hero__lead {
    max-width: 580px;
    margin: 26px 0 0;
    color: var(--han-color-text-secondary);
    font-size: 17px;
    line-height: 1.95;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero__note {
    margin: 22px 0 0;
    color: var(--han-color-text-tertiary);
    font-family: var(--han-font-sans);
    font-size: 12px;
    letter-spacing: .08em;
  }

  .hero__visual {
    position: relative;
    min-height: 440px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 36px;
    border: 1px solid var(--han-color-border);
    background:
      radial-gradient(circle at 70% 25%, color-mix(in srgb, var(--han-color-accent-decorative) 34%, transparent), transparent 30%),
      linear-gradient(160deg, var(--han-color-bg-surface), var(--han-color-bg-elevated));
    box-shadow: 0 24px 60px color-mix(in srgb, var(--han-color-text-primary) 10%, transparent);
  }
  .hero__visual::before {
    content: "";
    position: absolute;
    left: 12%;
    bottom: 12%;
    width: 46%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--han-color-accent-control) 40%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 22px color-mix(in srgb, var(--han-color-accent-control) 6%, transparent);
  }
  .hero__visual::after {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid color-mix(in srgb, var(--han-color-border) 60%, transparent);
    pointer-events: none;
  }
  .hero__vertical {
    margin: 0;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: var(--han-font-kai);
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: .32em;
    color: var(--han-color-text-primary);
    line-height: 1;
  }
  .hero__seal { position: absolute; left: 36px; bottom: 36px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 48px; }
    .hero__visual { min-height: 320px; }
  }
  @media (max-width: 560px) {
    h1 { font-size: clamp(32px, 10vw, 44px); }
    .hero__lead { font-size: 16px; }
    .hero__visual { min-height: 260px; padding: 24px; }
    .hero__seal { left: 24px; bottom: 24px; }
  }
</style>
