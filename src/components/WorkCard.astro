---
import type { Work } from '../data/site';
interface Props { work: Work; index: number }
const { work, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const numerals = ['一', '二', '三', '四', '五', '六', '七', '八', '九'];
const reverse = index % 2 === 1;
---
<article class:list={['work', { 'work--reverse': reverse }]} id={`work-${work.slug}`}>
  <div class="work__media">
    {work.image ? (
      <img src={`${base}${work.image}`} alt={work.imageAlt} loading="lazy" width="1280" height="800" />
    ) : (
      <div class="work__placeholder" role="img" aria-label={`${work.title} 截图待补充`} data-replaceable="true">
        <span class="work__placeholder-title">{work.title}</span>
        <span class="work__placeholder-kicker">{work.kicker}</span>
      </div>
    )}
  </div>
  <div class="work__body">
    <span class="work__index">{numerals[index]} · {work.kicker}</span>
    <h3>{work.title}</h3>
    <p class="work__period">{work.period}</p>
    <p class="work__summary">{work.summary}</p>
    <ul class="work__highlights">
      {work.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <ul class="work__stack" aria-label="技术栈">
      {work.stack.map((s) => <li>{s}</li>)}
    </ul>
    {work.links.length > 0 && (
      <p class="work__links">
        {work.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} →</a>)}
      </p>
    )}
  </div>
</article>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: clamp(36px, 5vw, 56px) 0;
    border-top: 1px solid var(--han-color-border);
  }
  .work:last-child { padding-bottom: 0; }
  .work--reverse .work__media { order: 2; }

  .work__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--han-color-border);
    background: var(--han-color-bg-surface);
    box-shadow: 0 18px 44px color-mix(in srgb, var(--han-color-text-primary) 8%, transparent);
  }
  .work__media img { width: 100%; height: 100%; object-fit: cover; }

  .work__placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 28px;
    background:
      radial-gradient(circle at 78% 22%, color-mix(in srgb, var(--han-color-accent-decorative) 36%, transparent), transparent 32%),
      linear-gradient(155deg, var(--han-color-bg-surface), var(--han-color-bg-elevated));
  }
  .work__placeholder::before {
    content: "";
    position: absolute;
    right: -10%;
    top: -18%;
    width: 52%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--han-color-accent-control) 32%, transparent);
    border-radius: 50%;
  }
  .work__placeholder-title {
    font-family: var(--han-font-kai);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.3;
    letter-spacing: .1em;
    color: var(--han-color-text-primary);
  }
  .work__placeholder-kicker {
    margin-top: 10px;
    font-family: var(--han-font-sans);
    font-size: 13px;
    letter-spacing: .1em;
    color: var(--han-color-text-secondary);
  }

  .work__index {
    color: var(--han-color-accent-text);
    font-family: var(--han-font-kai);
    font-size: 13px;
    letter-spacing: .12em;
  }
  h3 { margin: 14px 0 4px; font-size: clamp(24px, 3vw, 32px); line-height: 1.3; letter-spacing: .06em; }
  .work__period { margin: 0 0 14px; color: var(--han-color-text-tertiary); font-family: var(--han-font-sans); font-size: 13px; }
  .work__summary { margin: 0; color: var(--han-color-text-primary); font-size: 16px; line-height: 1.9; }
  .work__highlights { margin: 16px 0 0; padding: 0; list-style: none; }
  .work__highlights li { position: relative; padding-left: 16px; margin-bottom: 6px; color: var(--han-color-text-secondary); font-size: 14.5px; line-height: 1.8; }
  .work__highlights li::before { content: ""; position: absolute; left: 0; top: .78em; width: 5px; height: 5px; border-radius: 50%; background: var(--han-color-accent-control); }
  .work__stack { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .work__stack li {
    padding: 2px 10px;
    border: 1px solid var(--han-color-border);
    border-radius: 2px;
    background: var(--han-color-bg-surface);
    color: var(--han-color-text-secondary);
    font-family: var(--han-font-sans);
    font-size: 12px;
    letter-spacing: .04em;
  }
  .work__links { margin: 18px 0 0; font-family: var(--han-font-sans); font-size: 14px; }
  .work__links a + a { margin-left: 16px; }

  @media (max-width: 860px) {
    .work { grid-template-columns: 1fr; gap: 24px; }
    .work--reverse .work__media { order: 0; }
    .work__placeholder { padding: 20px; }
  }
</style>
